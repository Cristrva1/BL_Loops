{
  "$defs": {
    "DocumentRights": {
      "additionalProperties": false,
      "properties": {
        "rights_status": {
          "$ref": "#/$defs/RightsStatus"
        },
        "license": {
          "maxLength": 160,
          "minLength": 2,
          "title": "License",
          "type": "string"
        },
        "usage_basis": {
          "maxLength": 300,
          "minLength": 8,
          "title": "Usage Basis",
          "type": "string"
        },
        "jurisdiction": {
          "maxLength": 40,
          "minLength": 2,
          "title": "Jurisdiction",
          "type": "string"
        },
        "retention_allowed": {
          "title": "Retention Allowed",
          "type": "boolean"
        },
        "extraction_allowed": {
          "title": "Extraction Allowed",
          "type": "boolean"
        },
        "quotation_allowed": {
          "title": "Quotation Allowed",
          "type": "boolean"
        },
        "redistribution_allowed": {
          "title": "Redistribution Allowed",
          "type": "boolean"
        },
        "notebooklm_upload_allowed": {
          "title": "Notebooklm Upload Allowed",
          "type": "boolean"
        },
        "evidence": {
          "maxLength": 500,
          "minLength": 8,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "rights_status",
        "license",
        "usage_basis",
        "jurisdiction",
        "retention_allowed",
        "extraction_allowed",
        "quotation_allowed",
        "redistribution_allowed",
        "notebooklm_upload_allowed",
        "evidence"
      ],
      "title": "DocumentRights",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "public_domain",
        "open_license",
        "explicit_permission",
        "restricted",
        "unknown"
      ],
      "title": "RightsStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "pattern": "^[a-z][a-z0-9_-]{1,80}$",
      "title": "Document Id",
      "type": "string"
    },
    "source_file_name": {
      "maxLength": 260,
      "minLength": 1,
      "title": "Source File Name",
      "type": "string"
    },
    "source_media_type": {
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ],
      "title": "Source Media Type",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "author": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Author",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "es"
      ],
      "title": "Language",
      "type": "string"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Topics",
      "type": "array"
    },
    "original_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Sha256",
      "type": "string"
    },
    "markdown_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Markdown Sha256",
      "type": "string"
    },
    "extractor": {
      "const": "markitdown",
      "default": "markitdown",
      "title": "Extractor",
      "type": "string"
    },
    "extractor_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Extractor Version",
      "type": "string"
    },
    "locator_strategy": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Locator Strategy",
      "type": "string"
    },
    "markdown_path": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Markdown Path",
      "type": "string"
    },
    "manifest_path": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Manifest Path",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/DocumentRights"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "source_file_name",
    "source_media_type",
    "title",
    "author",
    "language",
    "original_sha256",
    "markdown_sha256",
    "extractor_version",
    "locator_strategy",
    "markdown_path",
    "manifest_path",
    "rights",
    "created_at",
    "content_hash"
  ],
  "title": "DocumentImportRecord",
  "type": "object"
}

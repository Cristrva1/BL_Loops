# 02-single-agent - configuracion local portable
# Copia este archivo como .env solo si el laboratorio vive fuera de BL_Loops.

OLLAMA_BASE_URL=http://127.0.0.1:11434
SIMPLE_AGENT_MODEL=gemma4:e4b
SIMPLE_AGENT_TIMEOUT_SECONDS=300
SIMPLE_AGENT_RUNS_DIR=.local/runs

# La aplicacion solo acepta Ollama en localhost y no usa telemetria.
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false

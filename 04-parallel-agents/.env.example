# Contrato portable de 04-parallel-agents.
# Copia este archivo como .env si el laboratorio vive fuera de BL_Loops.
# No pongas secretos. No actives red, telemetria ni escrituras externas.

OLLAMA_BASE_URL=http://127.0.0.1:11434
PARALLEL_MODEL=qwen3.5:4b
PARALLEL_TIMEOUT_SECONDS=180
PARALLEL_BRANCH_TIMEOUT_SECONDS=180
PARALLEL_MAX_IN_FLIGHT=3
PARALLEL_RUNS_DIR=.local/runs

BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_ALLOW_EXTERNAL_WRITES=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false

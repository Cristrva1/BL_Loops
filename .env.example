# BL_Loops - configuracion global local
# Copia este archivo como .env. El .env real nunca se versiona.
# No definas UV_PROJECT_ENVIRONMENT aqui: cada laboratorio usa su propia .venv.

BL_LOOPS_CONFIG_VERSION=1
BL_LOOPS_ENV=development
BL_LOOPS_HOST=127.0.0.1

# Toda inferencia de los laboratorios pasa por Ollama local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=D:/ollama

# Escalera inicial: basico -> estandar, con una familia alternativa.
BL_LOOPS_MODEL_BASIC=qwen3.5:4b
BL_LOOPS_MODEL_STANDARD=qwen3.5:9b
BL_LOOPS_MODEL_ALT_BASIC=gemma4:e2b
BL_LOOPS_MODEL_ALT_STANDARD=gemma4:e4b

# Se decidiran e instalaran al comenzar los laboratorios RAG.
BL_LOOPS_EMBEDDING_MODEL=
BL_LOOPS_RERANKER_MODEL=

# Ruta local opcional para repositorios de referencia. Configúrala solo en tu
# .env; los proyectos no comparten código, bases de datos ni procesos en ejecución.
BL_LOOPS_REPOSITORY_LIBRARY=
BL_LOOPS_DATA_DIR=.local/data
BL_LOOPS_RUNS_DIR=.local/runs
BL_LOOPS_LOGS_DIR=.local/logs

# Seguridad local por defecto.
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_ALLOW_EXTERNAL_WRITES=false
BL_LOOPS_ALLOW_REAL_CONNECTORS=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false

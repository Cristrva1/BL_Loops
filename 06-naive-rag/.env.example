# 06-naive-rag - configuracion local portable
# Copia este archivo como .env solo si el laboratorio vive fuera de BL_Loops.

OLLAMA_BASE_URL=http://127.0.0.1:11434
NAIVE_RAG_MODEL=qwen3.5:4b
NAIVE_RAG_TIMEOUT_SECONDS=300
NAIVE_RAG_INDEX_PATH=.local/data/books.sqlite3
NAIVE_RAG_RUNS_DIR=.local/runs
NAIVE_RAG_TOP_K=4
NAIVE_RAG_CHUNK_CHARS=1200

# La aplicacion solo acepta Ollama en localhost y no usa telemetria.
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false


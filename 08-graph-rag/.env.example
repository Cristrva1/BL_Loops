# 08-graph-rag - configuracion local portable
# Copia este archivo como .env solo si el laboratorio vive fuera de BL_Loops.

OLLAMA_BASE_URL=http://127.0.0.1:11434
GRAPH_RAG_MODEL=qwen3.5:4b
GRAPH_RAG_TIMEOUT_SECONDS=300
GRAPH_RAG_INDEX_PATH=.local/data/graph.sqlite3
GRAPH_RAG_RUNS_DIR=.local/runs
GRAPH_RAG_TOP_K=5
GRAPH_RAG_CHUNK_CHARS=1200
GRAPH_RAG_MAX_HOPS=3
GRAPH_RAG_MODE=graph

# La aplicacion solo acepta Ollama en localhost y no usa telemetria.
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false

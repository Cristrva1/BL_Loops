# Copia este archivo a .env si usas el laboratorio fuera de BL_Loops.
# Dentro del workspace, el .env de la raíz cubre los valores comunes.

OLLAMA_BASE_URL=http://127.0.0.1:11434
LOOP_MODEL=qwen3.5:4b
LOOP_TIMEOUT_SECONDS=60
LOOP_RUNS_DIR=.local/runs
BL_LOOPS_TELEMETRY=false
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_ALLOW_EXTERNAL_WRITES=false

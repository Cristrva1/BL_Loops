# Configuración local del laboratorio cuando se copia fuera de BL_Loops.
# Dentro del workspace se reutiliza automáticamente el .env de la raíz.

BL_LOOPS_CONFIG_VERSION=1
BL_LOOPS_ENV=development
BL_LOOPS_HOST=127.0.0.1

OLLAMA_BASE_URL=http://127.0.0.1:11434
BL_LOOPS_MODEL_BASIC=qwen3.5:4b
BL_LOOPS_MODEL_STANDARD=qwen3.5:9b
BL_LOOPS_MODEL_ALT_BASIC=gemma4:e2b
BL_LOOPS_MODEL_ALT_STANDARD=gemma4:e4b

BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_ALLOW_EXTERNAL_WRITES=false
BL_LOOPS_ALLOW_REAL_CONNECTORS=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false


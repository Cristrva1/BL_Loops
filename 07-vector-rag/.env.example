# 07-vector-rag - configuracion local portable
OLLAMA_BASE_URL=http://127.0.0.1:11434
VECTOR_RAG_CHAT_MODEL=qwen3.5:4b
VECTOR_RAG_EMBEDDING_MODEL=qwen3-embedding:latest
VECTOR_RAG_EMBEDDING_DIMENSIONS=768
VECTOR_RAG_EMBEDDING_BATCH_SIZE=16
VECTOR_RAG_TIMEOUT_SECONDS=300
VECTOR_RAG_INDEX_PATH=.local/data/books-hybrid.sqlite3
VECTOR_RAG_RUNS_DIR=.local/runs
VECTOR_RAG_TOP_K=5
VECTOR_RAG_CHUNK_CHARS=1200
VECTOR_RAG_MODE=hybrid

BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false


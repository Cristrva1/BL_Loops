# 25-meeting-summarizer - Configuración local
# Copia este archivo como .env para personalizar variables locales.

BL_LOOPS_ENV=development
HOST=127.0.0.1
PORT=8025
FRONTEND_PORT=5175

# Inferencia local con Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_SECONDS=180.0
OLLAMA_NUM_CTX=16384

# Almacenamiento local
DATA_DIR=.local/data
RUNS_DIR=.local/runs
LOGS_DIR=.local/logs

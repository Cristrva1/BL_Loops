# Configuración local del laboratorio cuando se copia fuera de BL_Loops.
# Dentro del workspace se reutiliza automáticamente el .env de la raíz.
# No imprimas un .env real ni lo registres en logs.

BL_LOOPS_CONFIG_VERSION=1
BL_LOOPS_ENV=development
BL_LOOPS_HOST=127.0.0.1

OLLAMA_BASE_URL=http://127.0.0.1:11434
CURATOR_MODEL=
CURATOR_EMBEDDING_MODEL=

NETWORK_ENABLED=false
# Lista separada por comas. Déjala vacía hasta definir los hosts exactos aprobados.
ALLOWED_DOMAINS=
# Cero impide toda solicitud aun cuando los demás gates estén activos.
MAX_URLS_PER_RUN=0
MAX_BYTES_PER_SOURCE=2000000
MAX_RESEARCH_ROUNDS=3
MAX_CLAIM_REVISIONS=2
# Falla explícitamente antes de inferir si un documento necesita más chunks.
MAX_LLM_CHUNKS_PER_DOCUMENT=8

# Alcance de investigación. El vertical y la jurisdicción reales no se presuponen.
RESEARCH_DOMAIN=sales-books-education
RESEARCH_JURISDICTION=
RESEARCH_LANGUAGES=en,es
# Identifica el cliente ante los catálogos y sitios autorizados.
RESEARCH_USER_AGENT=BL-Loops-SalesCurator/0.2 educational-research

TELEMETRY_ENABLED=false
RAW_CONTENT_IN_RUN_LOGS=false

# La red exige simultáneamente estos dos gates, NETWORK_ENABLED=true,
# allowlist no vacía, presupuesto de URL y autorización explícita por corrida.
BL_LOOPS_RUNTIME_NETWORK=false
BL_LOOPS_ALLOW_EXTERNAL_WRITES=false
BL_LOOPS_ALLOW_REAL_CONNECTORS=false
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_PII=false

# Siempre relativas a la raíz del laboratorio.
BL_LOOPS_DATA_DIR=.local/data
BL_LOOPS_RUNS_DIR=.local/runs

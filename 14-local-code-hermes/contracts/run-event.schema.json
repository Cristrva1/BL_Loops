{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bl-loops.local/14-local-code-hermes/run-event.schema.json",
  "title": "Hermes local-code run event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "timestamp",
    "event_type",
    "lab_id",
    "variant_id",
    "case_id",
    "model",
    "node",
    "payload",
    "metrics",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "event_type": {
      "type": "string",
      "enum": [
        "run.started",
        "node.started",
        "node.completed",
        "node.failed",
        "run.completed",
        "run.failed",
        "run.blocked"
      ]
    },
    "lab_id": { "const": "14-local-code-hermes" },
    "variant_id": { "const": "ollama-hermes-preflight" },
    "case_id": { "const": "F-LOCAL-CODE-004@0.1.0" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "source_model",
        "digest",
        "context_configured",
        "endpoint"
      ],
      "properties": {
        "provider": { "const": "ollama" },
        "name": { "const": "local-code-9b-64k" },
        "source_model": { "const": "qwen3.5:9b" },
        "digest": { "type": "null" },
        "context_configured": { "const": 65536 },
        "endpoint": { "type": "string", "pattern": "^http://" }
      }
    },
    "node": { "type": ["object", "null"] },
    "payload": { "type": "object" },
    "metrics": { "type": "object" },
    "artifact_refs": { "type": "array", "maxItems": 0 }
  }
}

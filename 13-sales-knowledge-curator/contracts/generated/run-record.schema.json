{
  "$defs": {
    "MetricScore": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "name"
      ],
      "title": "MetricScore",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "ram_peak_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Peak Mb"
        },
        "vram_peak_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vram Peak Mb"
        }
      },
      "required": [
        "latency_ms"
      ],
      "title": "ResourceUsage",
      "type": "object"
    },
    "RunEvent": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-z][a-z0-9_-]{1,80}$",
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^[a-z][a-z0-9_-]{1,80}$",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "node_id": {
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/WorkflowStatus"
        },
        "tool": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "result_sanitized": {
          "additionalProperties": true,
          "title": "Result Sanitized",
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "ram_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ram Mb"
        },
        "vram_mb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vram Mb"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "event_id",
        "occurred_at",
        "node_id",
        "state"
      ],
      "title": "RunEvent",
      "type": "object"
    },
    "WorkflowStatus": {
      "enum": [
        "scope_draft",
        "inventory_running",
        "gaps_ready",
        "research_planned",
        "awaiting_external_authorization",
        "collecting_local",
        "sources_normalized",
        "claims_extracted",
        "verification_running",
        "conflicts_open",
        "review_pending",
        "changes_requested",
        "approved",
        "rejected",
        "staging",
        "validating",
        "published",
        "failed"
      ],
      "title": "WorkflowStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "pattern": "^[a-z][a-z0-9_-]{1,80}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "lab_id": {
      "const": "13-sales-knowledge-curator",
      "default": "13-sales-knowledge-curator",
      "title": "Lab Id",
      "type": "string"
    },
    "variant": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Variant",
      "type": "string"
    },
    "commit_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit Sha"
    },
    "model_ref": {
      "title": "Model Ref",
      "type": "string"
    },
    "evaluation_case": {
      "title": "Evaluation Case",
      "type": "string"
    },
    "case_version": {
      "title": "Case Version",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RunEvent"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "inputs_sanitized": {
      "additionalProperties": true,
      "title": "Inputs Sanitized",
      "type": "object"
    },
    "outputs_sanitized": {
      "additionalProperties": true,
      "title": "Outputs Sanitized",
      "type": "object"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    },
    "resource_usage": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/MetricScore"
      },
      "title": "Scores",
      "type": "array"
    },
    "aggregate_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Score"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "failure_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Failure Reasons",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "variant",
    "model_ref",
    "evaluation_case",
    "case_version",
    "events",
    "inputs_sanitized",
    "outputs_sanitized",
    "resource_usage",
    "scores",
    "status",
    "created_at",
    "content_hash"
  ],
  "title": "RunRecord",
  "type": "object"
}

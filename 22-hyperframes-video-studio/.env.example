# 22-hyperframes-video-studio
# Configuración de IA Local y Runtime de HyperFrames

# Ollama local endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Servidor del Laboratorio
PORT=8022
HOST=127.0.0.1

# HyperFrames config
HYPERFRAMES_WIDTH=1920
HYPERFRAMES_HEIGHT=1080
HYPERFRAMES_FPS=30
HYPERFRAMES_WORKERS=6
OUTPUT_DIR=.local/output

# 24-open-generative-ai-studio
# Copia este archivo como `.env` solo si necesitas cambiar algún valor.
# Fusión por clave: primero el `.env` de la raíz de BL_Loops, después este `.env` (gana clave a
# clave) y, por último, las variables del proceso (ganan siempre).

# Ollama debe ser HTTP en loopback; se rechaza cualquier host remoto o modelo `:cloud`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# El panel y la API escuchan solo en una interfaz local.
HOST=127.0.0.1
PORT=8024

# Opcional: fuente TrueType para el texto del animatic. Si se deja vacío, se busca una del sistema
# (Segoe UI o Arial en Windows, Arial en macOS, DejaVu Sans en Linux).
ANIMATIC_FONT_FILE=

# Contrato visible de configuracion; este corte no carga archivos .env automaticamente.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_CODE_MODEL=local-code-9b-64k
LOCAL_CODE_SOURCE_MODEL=qwen3.5:9b
LOCAL_CODE_NUM_CTX=65536
LOCAL_CODE_MODE=exploratory
LOCAL_CODE_RUNS_DIR=.local/runs
LOCAL_CODE_SANDBOX_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
LOCAL_CODE_ALLOW_DIRTY_WORKTREE=false

# No son secretos. Solo deben marcarse tras obtener evidencia humana autorizada.
LOCAL_CODE_NETWORK_PROOF=unverified
LOCAL_CODE_FIREWALL_PROOF_ID=
LOCAL_CODE_SERVER_PROFILE_PROOF=unverified
LOCAL_CODE_SERVER_PROFILE_PROOF_ID=

# Limites didacticos ajustables para el preflight manual.
LOCAL_CODE_MIN_RAM_AVAILABLE_GIB=8
LOCAL_CODE_MIN_COMMIT_HEADROOM_GIB=8
LOCAL_CODE_MIN_VRAM_FREE_MIB=12288

OLLAMA_NO_CLOUD=1
BL_LOOPS_TELEMETRY=false
BL_LOOPS_STORE_RAW_CONTENT=false
